# Copy to .env and edit. Read at startup on the server only (never sent to the browser, never committed).

# REQUIRED: site-wide access password shown on the gate page.
SITE_PASSWORD=change-me

# Database. If TURSO_DATABASE_URL is set the app uses Turso/libSQL; otherwise a local SQLite file (DATA_DIR/rtc.sqlite).
# TURSO_DATABASE_URL=libsql://reduced-to-clear-<your-org>.turso.io
# TURSO_AUTH_TOKEN=

# Cookie-signing secret. REQUIRED in hosted mode (Turso remote, or on Render/Railway): env only, never written to disk.
# Locally, if unset, a random one is generated in DATA_DIR/secret.
# SITE_SECRET=

# Photos. Where they're stored: PHOTO_STORAGE=db (BLOB table in the database; default when TURSO_DATABASE_URL is set)
# or disk (files in UPLOADS_DIR; default otherwise).
#   db storage:   photos ON unless PHOTOS_ENABLED=false
#   disk storage: photos OFF unless PHOTOS_ENABLED=true (needs a persistent disk)
PHOTOS_ENABLED=true
# PHOTO_STORAGE=db
# MAX_PHOTO_KB=300          # per-photo cap after EXIF/metadata stripping (browser shrinks to fit first)
# PHOTO_RETENTION_DAYS=30   # older photos are deleted (post stays), checked at start and every 12h

# Stores worldwide are fetched on demand from OpenStreetMap's Overpass API and cached in the DB (rate-limited).
# OSM_ON_DEMAND=true
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.kumi.systems/api/interpreter
# OVERPASS_MIN_INTERVAL_MS=2000   OVERPASS_DAILY_MAX=500   OSM_NEW_TILES_PER_IP_HOUR=30   OSM_CACHE_DAYS=30   OSM_WAIT_MS=8000
# PUBLIC_URL=https://your-site.example   # shown in the Overpass User-Agent (Render sets RENDER_EXTERNAL_URL automatically)

# Optional
PORT=3000
# DATA_DIR=./data          # local SQLite DB + generated secret
# UPLOADS_DIR=./uploads    # photo files (only for PHOTO_STORAGE=disk)
# DB_FILE=./data/rtc.sqlite
