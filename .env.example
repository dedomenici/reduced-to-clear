# Copy to .env and edit. Read at startup on the server only (never sent to the browser, never committed).

# REQUIRED: site-wide access password shown on the gate page.
SITE_PASSWORD=change-me

# Database. If TURSO_DATABASE_URL is set the app uses Turso/libSQL; otherwise a local SQLite file (DATA_DIR/rtc.sqlite).
# TURSO_DATABASE_URL=libsql://reduced-to-clear-<your-org>.turso.io
# TURSO_AUTH_TOKEN=

# Cookie-signing secret. REQUIRED in hosted mode (Turso remote, or on Render/Railway): env only, never written to disk.
# Locally, if unset, a random one is generated in DATA_DIR/secret.
# SITE_SECRET=

# Photo uploads need persistent file storage. Off unless "true" (free hosting has no persistent disk).
PHOTOS_ENABLED=true

# Optional
PORT=3000
# DATA_DIR=./data          # local SQLite DB + generated secret
# UPLOADS_DIR=./uploads    # photo files (only when PHOTOS_ENABLED=true)
# DB_FILE=./data/rtc.sqlite
