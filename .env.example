# Copy to .env and edit. .env is read at startup on the server only (never sent to the browser, never committed).
# REQUIRED: site-wide access password shown on the gate page.
SITE_PASSWORD=change-me
# Optional: secret for signing the gate cookie (a random one is generated in DATA_DIR/secret if unset).
SITE_SECRET=
# Optional: port (hosts like Render/Railway set this automatically).
PORT=3000
# Optional: directory for the SQLite DB, uploads and generated secret (default ./data, uploads default ./uploads).
# On Render with a persistent disk use /var/data
# DATA_DIR=/var/data
# Optional overrides:
# DB_FILE=/var/data/rtc.sqlite
# UPLOADS_DIR=/var/data/uploads
